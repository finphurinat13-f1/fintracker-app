rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Signing up is open to anyone who reaches the page, and approval is a
    // separate step an admin has to take. Owning the uid therefore proves only
    // that an account exists — not that it is allowed to store anything here.
    // Without this, a pending account could write to its own path straight
    // through the API and spend the project's quota while its request sat
    // unread. The app already refuses to upload before approval; this makes the
    // rule true regardless of which client is asking.
    // A verified address is required alongside approval: it proves the account
    // belongs to a reachable person rather than a typo or a throwaway, and
    // checking it here rather than only on screen means it cannot be skipped by
    // talking to the API directly.
    // The admin used to be named here by address. These rules ship in a public
    // repository, so that told anyone reading which account approves everybody
    // — and the same address was in the bundle the browser downloads. It is a
    // custom claim now, minted by /api/claimadmin from an address held in the
    // functions deploy environment, so nothing readable names the account.
    function approved() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        (request.auth.token.email_verified == true &&
         exists(/databases/$(database)/documents/registry/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/registry/$(request.auth.uid)).data.status == 'approved')
      );
    }

    // User data — only accessible by the owner, and only once approved
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId
                         && approved();
    }

    // Registry — a user may read + create ONLY their own entry, and only as
    // 'pending'. Changing status (approve/reject) is restricted to the admin,
    // so nobody can self-approve by writing straight to Firestore.
    match /registry/{userId} {
      allow read: if request.auth != null
                  && request.auth.uid == userId;
      // Only these three fields, and the address has to be the one the token
      // was issued for. Checking the status alone let a signed-in stranger
      // write their entry with any shape they liked — an address belonging to
      // somebody else, and a role saying admin. Neither grants anything: the
      // rules read the claim, not the document. But both are read straight off
      // the account list, which is where approvals get decided, and a row that
      // reads "ceo@bank.com  ADMIN" is asking to be waved through.
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.keys().hasOnly(['email', 'status', 'createdAt'])
                    && request.resource.data.status == 'pending'
                    && request.resource.data.email == request.auth.token.email;
      allow read, write: if request.auth != null
                         && request.auth.token.admin == true;
    }
  }
}
