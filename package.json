{
  "name": "claudy-build",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build": "node build/build.mjs",
    "deploy": "npm run lint && node build/build.mjs && firebase deploy --only hosting",
    "test": "node --test \"tests/*.test.mjs\"",
    "audit": "node tests/audit.mjs",
    "check": "npm run lint && npm run test && npm run audit && npm run build",
    "lint": "eslint fintracker/src tests build functions"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "tailwindcss": "^3.4.17"
  }
}
